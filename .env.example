# LLM
LLM_DEFAULT_MODEL=qwen-flash
VL_MODEL=qwen3-vl-flash
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_TEMPERATURE=0.1
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# Local embedding and reranker
BGE_M3=BAAI/bge-m3
BGE_M3_PATH=./models/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=1
BGE_RERANKER_LARGE=./models/bge-reranker-base
BGE_RERANKER_MODEL_ID=BAAI/bge-reranker-base
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=1

# Local Docker services
MILVUS_URL=http://127.0.0.1:19630
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
MONGO_URL=mongodb://punditrag:replace-with-password@127.0.0.1:27017/kb002?authSource=admin
MONGO_DB_NAME=kb002
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-password
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=upload-images
MINIO_SECURE=False
MINIO_PUBLIC_READ=False
ASSET_BASE_URL=http://127.0.0.1:8000/assets

# API security and upload limits
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001,http://localhost:8000,http://localhost:8001
MAX_UPLOAD_FILES=20
MAX_UPLOAD_SIZE_MB=50

# Retrieval and chunking
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=80
DENSE_SPEC_GROUP_LINES=5
DENSE_SPEC_OVERLAP_LINES=1
RETRIEVAL_TOP_K=20
TOPIC_EXPANSION_TOP_K=10
RRF_TOP_K=30
RERANK_MAX_TOP_K=8
RERANK_MIN_TOP_K=2
RERANK_FALLBACK_TOP_K=3
RERANK_MIN_SCORE=0.09
RERANK_GAP_ABS=0.18
RERANK_GAP_RATIO=0.35

# MinerU
MINERU_API_TOKEN=replace-with-your-mineru-token
MINERU_BASE_URL=https://mineru.net/api/v4

# Logging
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
SUMMARY_BATCH_CHARS=24000
SUMMARY_MAX_CHUNKS=2000
